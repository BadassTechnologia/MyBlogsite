---
layout: base.njk
title: Categories - Bloogsite
description: Browse Bloogsite by topic — Tech, AI Tools, Finance, Tech Jobs, Health, Travel, Education, Marketing, and Lifestyle.
activeNav: categories
permalink: /categories/
---

<section class="page-banner">

<h1>Explore All Categories</h1>

<p>Every topic we write about, in one place. Pick one to see the articles inside it.</p>

</section>

<form class="search" role="search" data-search-mode="categories">

<label class="search-label" for="category-search">Filter categories</label>

<div class="search-row">
<input id="category-search" type="search" name="query" placeholder="Try “tech”, “travel”, or “finance”" autocomplete="off" aria-controls="category-list" aria-describedby="category-search-status">
<button class="search-button" type="submit">Filter</button>
</div>

<p id="category-search-status" class="search-status" role="status" aria-live="polite">{{ categories | length }} categories available.</p>

</form>

<noscript><p class="search-noscript">Category filtering requires JavaScript. All categories remain available below.</p></noscript>

<section class="categories-section" style="padding-top:10px;">

<div id="category-list" class="categories">
{% for cat in categories %}
<a href="/categories/{{ cat.slug }}/" class="cat-card" data-category-card data-search-text="{{ cat.name }} {{ cat.slug }}">
<div class="cat-icon" style="background:{{ cat.bg }};">
<svg viewBox="0 0 24 24" fill="none" stroke="{{ cat.color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ cat.icon | safe }}</svg>
</div>
<div class="cat-info">
<h3>{{ cat.name }}</h3>
<p>{{ collections.postsByCategory[cat.slug] | length }} articles</p>
</div>
</a>
{% endfor %}
</div>

</section>

<script src="/assets/js/site-search.js?v={{ site.assetVersion }}" defer></script>
