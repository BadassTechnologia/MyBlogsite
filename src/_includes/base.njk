<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<link rel="icon" type="image/png" href="/assets/img/brand/bloogsite-icon-white.png?v={{ site.assetVersion }}">
<link rel="apple-touch-icon" href="/assets/img/brand/bloogsite-icon-white.png?v={{ site.assetVersion }}">

{% set pageTitle = title or site.name %}
{% set browserTitle = (pageTitle + " - " + site.name) if category else pageTitle %}
{% set pageDescription = description or excerpt or site.defaultDescription %}
{% set pageImage = image or site.defaultImage %}
{% set pageUrl = site.url + page.url %}

<title>{{ browserTitle }}</title>
{% if noindex %}<meta name="robots" content="noindex, follow">{% endif %}
<meta name="description" content="{{ pageDescription }}">
<meta name="application-name" content="{{ site.name }}">
<meta name="apple-mobile-web-app-title" content="{{ site.name }}">
{% if site.googleSiteVerification %}
<meta name="google-site-verification" content="{{ site.googleSiteVerification }}">
{% endif %}
<link rel="canonical" href="{{ pageUrl }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }} RSS Feed" href="/feed.xml">

<!-- Open Graph -->
<meta property="og:type" content="{{ 'article' if category else 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:image" content="{{ pageImage | absoluteUrl(site.url) }}">
<meta property="og:url" content="{{ pageUrl }}">
{% if category %}
<meta property="article:section" content="{{ category | catName(categories) }}">
<meta property="article:published_time" content="{{ (date or page.date) | isoDate }}">
{% endif %}

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
{% if site.twitterHandle %}
<meta name="twitter:site" content="{{ site.twitterHandle }}">
{% endif %}
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ pageImage | absoluteUrl(site.url) }}">

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ site.name | json | safe }},
  "description": {{ site.defaultDescription | json | safe }},
  "url": {{ site.url | json | safe }},
  "inLanguage": {{ site.locale | json | safe }},
  "sameAs": {{ site.socialUrls | json | safe }}
}
</script>

{% if category %}
{% set schemaAuthor = authors | selectattr("slug", "equalto", author) | first %}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  "headline": {{ title | json | safe }},
  "description": {{ pageDescription | json | safe }},
  "image": [{{ pageImage | absoluteUrl(site.url) | json | safe }}],
  {% if updated %}"dateModified": {{ updated | isoDate | json | safe }},{% endif %}
  "datePublished": {{ (date or page.date) | isoDate | json | safe }},
  "articleSection": {{ category | catName(categories) | json | safe }},
  "mainEntityOfPage": {{ pageUrl | json | safe }},
  "author": {
    "@type": {{ ("Organization" if schemaAuthor and schemaAuthor.slug == "ashok" else "Person") | json | safe }},
    "name": {{ (schemaAuthor.name if schemaAuthor else author) | json | safe }}
  },
  "publisher": {
    "@type": "Organization",
    "name": {{ site.name | json | safe }},
    "logo": {
      "@type": "ImageObject",
      "url": {{ "/assets/img/brand/bloogsite-icon-white.png" | absoluteUrl(site.url) | json | safe }}
    }
  }
}
</script>
{% endif %}

{% if category or activeCategory %}
<script type="application/ld+json">
{"@context":"https://schema.org","@type":"BreadcrumbList","itemListElement":[
{"@type":"ListItem","position":1,"name":"Home","item":{{ site.url | json | safe }}},
{"@type":"ListItem","position":2,"name":"Blogs","item":{{ (site.url + "/blogs/") | json | safe }}},
{"@type":"ListItem","position":3,"name":{{ (category or activeCategory) | catName(categories) | json | safe }},"item":{{ (site.url + "/categories/" + (category or activeCategory) + "/") | json | safe }}}{% if category %},
{"@type":"ListItem","position":4,"name":{{ title | json | safe }},"item":{{ pageUrl | json | safe }}}{% endif %}
]}
</script>
{% endif %}

{% if site.googleAnalyticsId %}
<script async src="https://www.googletagmanager.com/gtag/js?id={{ site.googleAnalyticsId }}"></script>
<script>
window.dataLayer = window.dataLayer || [];
function gtag(){dataLayer.push(arguments);}
gtag('js', new Date());
gtag('config', '{{ site.googleAnalyticsId }}');
</script>
{% endif %}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css?v={{ site.assetVersion }}">
<script>document.documentElement.classList.add('js');</script>
</head>

<body>
{% from "social-icon.njk" import socialIcon %}

<a class="skip-link" href="#main-content">Skip to main content</a>

{% if activeNav == 'home' %}
<aside class="home-announcement" aria-label="Bloogsite update">
<p>Practical guides for modern life.</p>
<a href="https://www.instagram.com/badass_technologia/" target="_blank" rel="noopener noreferrer">Follow Bloogsite on Instagram <span aria-hidden="true">→</span></a>
</aside>
{% endif %}

<header class="site-header">

<a href="/" class="logo" aria-label="Bloogsite home">
<span class="header-brand-logo" aria-hidden="true"><img src="/assets/img/brand/bloogsite-logo-white.png?v={{ site.assetVersion }}" alt="" width="500" height="250"></span>
<span class="visually-hidden">Bloogsite</span>
</a>

<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
<span class="visually-hidden">Open main menu</span>
<svg class="menu-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
<path d="M4 7h16M4 12h16M4 17h16"></path>
</svg>
<svg class="close-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
<path d="m6 6 12 12M18 6 6 18"></path>
</svg>
</button>

<nav id="primary-navigation" class="site-nav" aria-label="Primary navigation">

<a href="/" class="nav-link{% if activeNav == 'home' %} active{% endif %}"{% if activeNav == 'home' %} aria-current="page"{% endif %}>Home</a>

<div class="nav-dropdown">

<div class="dropdown-label-row">
<a href="/blogs/" class="nav-link dropdown-trigger{% if activeNav == 'blogs' or activeNav == 'categories' %} active{% endif %}"{% if activeNav == 'blogs' %} aria-current="page"{% endif %}>Blogs</a>
<button class="category-toggle" type="button" aria-expanded="false" aria-controls="category-menu" aria-label="Open blogs menu">
<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
</button>
</div>

<button class="blog-menu-dismiss" type="button" tabindex="-1" aria-label="Close blogs menu"></button>

<div id="category-menu" class="mega-menu blog-mega-menu" aria-label="Blogs menu">
<div class="blog-mega-categories"><p>Blog categories</p><div>
{% for cat in categories %}
<a href="/categories/{{ cat.slug }}/" class="mega-item{% if activeCategory == cat.slug %} active-cat{% endif %}"{% if activeCategory == cat.slug %} aria-current="page"{% endif %}>
<span class="mega-icon" style="background:{{ cat.bg }};">
<svg viewBox="0 0 24 24" fill="none" stroke="{{ cat.color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ cat.icon | safe }}</svg>
</span>
{{ cat.name }}
</a>
{% endfor %}
</div></div>
<div class="blog-mega-recent"><p>Featured &amp; recently published</p>
{% if collections.posts.length %}{% for post in collections.posts | limit(3) %}<a href="{{ post.url }}"><strong>{{ post.data.title }}</strong><span>Read article →</span></a>{% endfor %}{% else %}<span class="blog-mega-empty">New practical guides are being prepared.</span>{% endif %}
<a class="blog-mega-all" href="/blogs/">View all blogs →</a></div>
</div>

</div>

<a href="/about/" class="nav-link{% if activeNav == 'about' %} active{% endif %}"{% if activeNav == 'about' %} aria-current="page"{% endif %}>About</a>

<a href="/contact/" class="nav-link{% if activeNav == 'contact' %} active{% endif %}"{% if activeNav == 'contact' %} aria-current="page"{% endif %}>Contact</a>

</nav>

</header>

{{ content | safe }}

<footer class="site-footer">
<div class="footer-grid">
<div class="footer-brand"><a href="/" class="footer-logo">{{ site.name }}</a><p>Practical knowledge for better decisions across technology, money, careers, health, travel, and modern life.</p>
{% if site.socialLinks %}<nav class="footer-social-icons" aria-label="Bloogsite on social media">{% for social in site.socialLinks %}<a href="{{ social.url }}" rel="me noopener noreferrer" aria-label="{{ social.name }}">{{ socialIcon(social.name) }}</a>{% endfor %}</nav>{% endif %}</div>
<nav class="footer-column" aria-label="Footer navigation"><h2>Navigate</h2><a href="/">Home</a><a href="/blogs/">Blogs</a><a href="/about/">About</a><a href="/contact/">Contact</a></nav>
<nav class="footer-column" aria-label="Footer topics"><h2>Topics</h2>{% for cat in categories | limit(5) %}<a href="/categories/{{ cat.slug }}/">{{ cat.name }}</a>{% endfor %}</nav>
<div class="footer-column footer-newsletter"><h2>Newsletter</h2><p>Useful guides and important developments, without daily noise.</p><button type="button" disabled>Subscriptions coming soon</button></div>
</div>
<div class="footer-watermark" aria-hidden="true">bloogsite</div>
<div class="footer-bottom"><p>© {{ currentYear }} {{ site.name }}. All Rights Reserved.</p><nav aria-label="Legal"><a href="/privacy-policy/">Privacy Policy</a><a href="/terms/">Terms of Use</a><a href="/editorial-policy/">Editorial policy</a><a href="/feed.xml">RSS Feed</a></nav></div>
</footer>

<script>
(function () {
  var header = document.querySelector('.site-header');
  var nav = document.querySelector('.site-nav');
  var navToggle = document.querySelector('.nav-toggle');
  var navToggleLabel = navToggle && navToggle.querySelector('.visually-hidden');
  var dropdown = document.querySelector('.nav-dropdown');
  var categoryToggle = document.querySelector('.category-toggle');
  var menuDismiss = document.querySelector('.blog-menu-dismiss');
  var mobileQuery = window.matchMedia('(max-width: 768px)');

  if (!header || !nav || !navToggle || !dropdown || !categoryToggle) return;

  function setCategoryMenu(open, returnFocus) {
    dropdown.classList.toggle('open', open);
    if (open && !mobileQuery.matches) {
      var blogMenu = dropdown.querySelector('.blog-mega-menu');
      if (blogMenu) {
        var anchorRect = dropdown.getBoundingClientRect();
        var menuWidth = blogMenu.offsetWidth;
        var centeredLeft = anchorRect.width / 2 - menuWidth / 2;
        var viewportLeft = anchorRect.left + centeredLeft;
        var clampedLeft = Math.min(Math.max(16, viewportLeft), window.innerWidth - menuWidth - 16);
        blogMenu.style.setProperty('--blog-menu-x', (clampedLeft - anchorRect.left) + 'px');
      }
    }
    categoryToggle.setAttribute('aria-expanded', String(open));
    categoryToggle.setAttribute('aria-label', (open ? 'Close' : 'Open') + ' blogs menu');
    if (returnFocus) categoryToggle.focus();
  }

  function setMainMenu(open, returnFocus) {
    nav.classList.toggle('open', open);
    header.classList.toggle('nav-open', open);
    navToggle.setAttribute('aria-expanded', String(open));
    navToggleLabel.textContent = (open ? 'Close' : 'Open') + ' main menu';
    if (!open) setCategoryMenu(false, false);
    if (returnFocus) navToggle.focus();
  }

  navToggle.addEventListener('click', function () {
    setMainMenu(navToggle.getAttribute('aria-expanded') !== 'true', false);
  });

  categoryToggle.addEventListener('click', function () {
    setCategoryMenu(categoryToggle.getAttribute('aria-expanded') !== 'true', false);
  });

  if (menuDismiss) {
    menuDismiss.addEventListener('click', function () {
      setCategoryMenu(false, false);
    });
  }

  nav.addEventListener('click', function (event) {
    if (mobileQuery.matches && event.target.closest('a')) setMainMenu(false, false);
  });

  document.addEventListener('pointerdown', function (event) {
    if (!dropdown.contains(event.target)) setCategoryMenu(false, false);
    if (mobileQuery.matches && !header.contains(event.target)) setMainMenu(false, false);
  }, true);

  document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;
    if (categoryToggle.getAttribute('aria-expanded') === 'true') {
      setCategoryMenu(false, true);
    } else if (mobileQuery.matches && navToggle.getAttribute('aria-expanded') === 'true') {
      setMainMenu(false, true);
    }
  });

  function handleBreakpointChange(event) {
    setMainMenu(false, false);
    if (!event.matches) setCategoryMenu(false, false);
  }

  if (mobileQuery.addEventListener) {
    mobileQuery.addEventListener('change', handleBreakpointChange);
  } else {
    mobileQuery.addListener(handleBreakpointChange);
  }
})();
</script>

</body>
</html>
