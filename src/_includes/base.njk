<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

{% set pageTitle = title or site.name %}
{% set browserTitle = (pageTitle + " - " + site.name) if category else pageTitle %}
{% set pageDescription = description or excerpt or site.defaultDescription %}
{% set pageImage = image or site.defaultImage %}
{% set pageUrl = site.url + page.url %}

<title>{{ browserTitle }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ pageUrl }}">
<link rel="alternate" type="application/rss+xml" title="{{ site.name }} RSS Feed" href="/feed.xml">

<!-- Open Graph -->
<meta property="og:type" content="{{ 'article' if category else 'website' }}">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:image" content="{{ pageImage | absoluteUrl(site.url) }}">
<meta property="og:url" content="{{ pageUrl }}">

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image">
{% if site.twitterHandle %}
<meta name="twitter:site" content="{{ site.twitterHandle }}">
{% endif %}
<meta name="twitter:title" content="{{ pageTitle }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ pageImage | absoluteUrl(site.url) }}">

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/assets/css/style.css">
<script>document.documentElement.classList.add('js');</script>
</head>

<body>

<header class="site-header">

<a href="/" class="logo">{{ site.name }}</a>

<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
<span class="visually-hidden">Open main menu</span>
<svg class="menu-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
<path d="M4 7h16M4 12h16M4 17h16"></path>
</svg>
<svg class="close-icon" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
<path d="m6 6 12 12M18 6 6 18"></path>
</svg>
</button>

<nav id="primary-navigation" class="site-nav" aria-label="Primary navigation">

<a href="/" class="nav-link{% if activeNav == 'home' %} active{% endif %}"{% if activeNav == 'home' %} aria-current="page"{% endif %}>Home</a>

<a href="/#blogs" class="nav-link">Blogs</a>

<div class="nav-dropdown">

<div class="dropdown-label-row">
<a href="/categories/" class="nav-link dropdown-trigger{% if activeNav == 'categories' %} active{% endif %}"{% if activeNav == 'categories' and not activeCategory %} aria-current="page"{% endif %}>Categories</a>
<button class="category-toggle" type="button" aria-expanded="false" aria-controls="category-menu" aria-label="Open categories menu">
<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
</button>
</div>

<div id="category-menu" class="mega-menu" aria-label="Article categories">
{% for cat in categories %}
<a href="/categories/{{ cat.slug }}/" class="mega-item{% if activeCategory == cat.slug %} active-cat{% endif %}"{% if activeCategory == cat.slug %} aria-current="page"{% endif %}>
<span class="mega-icon" style="background:{{ cat.bg }};">
<svg viewBox="0 0 24 24" fill="none" stroke="{{ cat.color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ cat.icon | safe }}</svg>
</span>
{{ cat.name }}
</a>
{% endfor %}
</div>

</div>

<a href="#" class="nav-link">About</a>

<a href="#" class="nav-link">Contact</a>

</nav>

</header>

{{ content | safe }}

<footer>

<div class="footer-links">
<a href="/privacy-policy/">Privacy Policy</a>
<a href="/terms/">Terms of Use</a>
<a href="/categories/">Categories</a>
<a href="/feed.xml">RSS Feed</a>
</div>

{% if site.socialLinks %}
<nav class="footer-socials" aria-label="Bloogsite on social media">
{% for social in site.socialLinks %}
<a href="{{ social.url }}" rel="me noopener noreferrer">{{ social.name }}</a>
{% endfor %}
</nav>
{% endif %}

<p>© {{ currentYear }} {{ site.name }}. All Rights Reserved.</p>

</footer>

<script>
(function () {
  var header = document.querySelector('.site-header');
  var nav = document.querySelector('.site-nav');
  var navToggle = document.querySelector('.nav-toggle');
  var navToggleLabel = navToggle && navToggle.querySelector('.visually-hidden');
  var dropdown = document.querySelector('.nav-dropdown');
  var categoryToggle = document.querySelector('.category-toggle');
  var mobileQuery = window.matchMedia('(max-width: 768px)');

  if (!header || !nav || !navToggle || !dropdown || !categoryToggle) return;

  function setCategoryMenu(open, returnFocus) {
    dropdown.classList.toggle('open', open);
    categoryToggle.setAttribute('aria-expanded', String(open));
    categoryToggle.setAttribute('aria-label', (open ? 'Close' : 'Open') + ' categories menu');
    if (returnFocus) categoryToggle.focus();
  }

  function setMainMenu(open, returnFocus) {
    nav.classList.toggle('open', open);
    header.classList.toggle('nav-open', open);
    navToggle.setAttribute('aria-expanded', String(open));
    navToggleLabel.textContent = (open ? 'Close' : 'Open') + ' main menu';
    if (!open) setCategoryMenu(false, false);
    if (returnFocus) navToggle.focus();
  }

  navToggle.addEventListener('click', function () {
    setMainMenu(navToggle.getAttribute('aria-expanded') !== 'true', false);
  });

  categoryToggle.addEventListener('click', function () {
    setCategoryMenu(categoryToggle.getAttribute('aria-expanded') !== 'true', false);
  });

  nav.addEventListener('click', function (event) {
    if (mobileQuery.matches && event.target.closest('a')) setMainMenu(false, false);
  });

  document.addEventListener('click', function (event) {
    if (!dropdown.contains(event.target)) setCategoryMenu(false, false);
    if (mobileQuery.matches && !header.contains(event.target)) setMainMenu(false, false);
  });

  document.addEventListener('keydown', function (event) {
    if (event.key !== 'Escape') return;
    if (categoryToggle.getAttribute('aria-expanded') === 'true') {
      setCategoryMenu(false, true);
    } else if (mobileQuery.matches && navToggle.getAttribute('aria-expanded') === 'true') {
      setMainMenu(false, true);
    }
  });

  function handleBreakpointChange(event) {
    setMainMenu(false, false);
    if (!event.matches) setCategoryMenu(false, false);
  }

  if (mobileQuery.addEventListener) {
    mobileQuery.addEventListener('change', handleBreakpointChange);
  } else {
    mobileQuery.addListener(handleBreakpointChange);
  }
})();
</script>

</body>
</html>
