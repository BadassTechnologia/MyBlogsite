---
layout: base.njk
title: Bloogsite - Discover Amazing Stories Every Day
description: Practical, no-fluff articles on tech, AI tools, finance, careers, health, travel and more — written to actually help you make better decisions.
activeNav: home
---
{% from "article-card.njk" import articleCard %}

<section class="hero">

<div class="hero-text">

<h1>Discover Amazing Stories Every Day</h1>

<p>
Read inspiring articles on technology, AI, programming,
career growth and much more.
</p>

<a href="#blogs"><button>Start Reading</button></a>

</div>

<div class="hero-image">

<img
src="https://picsum.photos/1400/900"
alt=""
width="1400"
height="900"
fetchpriority="high"
decoding="async"
>

</div>

</section>

<form class="search" role="search" data-search-mode="articles">

<label class="search-label" for="article-search">Search all articles</label>

<div class="search-row">
<input id="article-search" type="search" name="query" placeholder="Try “JavaScript”, “finance”, or “AI tools”" autocomplete="off" aria-controls="article-search-results" aria-describedby="article-search-status">
<button class="search-button" type="submit">Search</button>
</div>

<p id="article-search-status" class="search-status" role="status" aria-live="polite">Type a word or phrase to search the article library.</p>

</form>

<section id="article-search-results" class="search-results" aria-label="Article search results" hidden>
<ul id="article-search-list" class="search-results-list"></ul>
</section>

<noscript><p class="search-noscript">Article search requires JavaScript. You can still browse the featured articles and category links below.</p></noscript>

<h2 class="section-title" id="blogs">Featured Blogs</h2>

<section class="blogs">
{% for post in collections.posts | limit(3) %}
{{ articleCard(post, categories) }}
{% endfor %}
</section>

<section class="categories-section">

<div class="categories-header">

<h2 class="section-title" style="padding:0;margin:0;">Popular Categories</h2>

<p>Browse articles by topic and find exactly what you're looking for.</p>

</div>

<a href="/categories/" class="view-all-link">View all categories →</a>

<div class="categories">
{% for cat in categories %}
<a href="/categories/{{ cat.slug }}/" class="cat-card">
<div class="cat-icon" style="background:{{ cat.bg }};">
<svg viewBox="0 0 24 24" fill="none" stroke="{{ cat.color }}" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">{{ cat.icon | safe }}</svg>
</div>
<div class="cat-info">
<h3>{{ cat.name }}</h3>
<p>{{ collections.postsByCategory[cat.slug] | length }} articles</p>
</div>
</a>
{% endfor %}
</div>

</section>

<section class="newsletter">

<h2>Subscribe to Our Newsletter</h2>

<p>Get the latest articles delivered directly to your inbox.</p>

<p class="newsletter-status">Newsletter signup is coming soon.</p>

</section>

<script src="/assets/js/site-search.js" defer></script>
